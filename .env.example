# Every variable this service reads, and nothing else.
#
# Rule 9 of docs/ecosystem/03 §2: a repository declares the variables it needs and the deploy
# provides exactly those. `env_file: .env` fan-out — which hands every container the whole
# estate's secrets — is banned, and this file is what makes the alternative possible: the deploy
# manifest is derived from it.
#
# Copy to `.env` for local work. `.env` is gitignored and must stay that way.

# --- required --------------------------------------------------------------------------------

# This service's own database. It reads no other, and CI fails on a second connection string.
POLICY_DATABASE_URL=postgres://cloudsforge:CHANGE_ME@127.0.0.1:5432/policy

# ── SERVING BOTH NETWORKS FROM ONE POD ────────────────────────────────────────
#
# Both OPTIONAL, and both empty here on purpose: a development stack is one
# network. See micro-deploy `docs/network-consolidation.md`.
#
# Set the second DSN and this deployment holds a handle per network, choosing
# per request from the `CF-Network` header the gateway stamps. Leave it empty and
# `networkSql` holds one handle and REFUSES a testnet request rather than
# answering it out of mainnet rows.
POLICY_DATABASE_URL_TESTNET=
# ── WHICH ESTATE THIS DEPLOYMENT IS ───────────────────────────────────────────
#
# REQUIRED in the estate, and the render sets it for every pod. It was once
# documented here as "never in production" and that was wrong twice over:
#
#   1. The pod keys its own database handle by it. Without it a testnet
#      deployment registers its testnet DSN under the name `mainnet` and then
#      refuses every request stamped `CF-Network: testnet`.
#
#   2. SERVICE-TO-SERVICE CALLS NEVER REACH THE GATEWAY. An outbox relay POSTing
#      to another service goes container to container; nothing stamps a header
#      on it and nothing can. Without a declared network those answer 500.
#
# The header still WINS when present, so this cannot mask a mis-stamped request
# from outside — it only answers the internal callers that never had one. Leave
# it empty only where a pod genuinely serves both estates.
CF_NETWORK_SINGLE=


# Identity's JWKS and issuer. Token verification is the only thing this service asks identity for.
IDENTITY_JWKS_URL=http://127.0.0.1:4001/.well-known/jwks.json
IDENTITY_ISSUER=http://127.0.0.1:4001

# --- optional, with the defaults shown ---------------------------------------------------------

PORT=4000
NODE_ENV=development
LOG_LEVEL=info
POLICY_DATABASE_POOL_MAX=10

# How long a decision is kept. 04-domain-model §10.4: "retained for the dispute window". The floor
# of 90 days is enforced in src/env.ts — a decision deleted before the argument about it has
# started is the one thing this table exists to prevent.
# POLICY_DECISION_RETENTION_DAYS=730

# How long a closed velocity window is kept. These are the highest-churn rows in the service and
# none of them is evidence of anything once the window has passed.
# POLICY_COUNTER_RETENTION_HOURS=48

# Names this replica in jobs.locked_by. Defaults to the hostname, which is the container id under
# compose and the pod name under Kubernetes.
# INSTANCE_ID=

# The image tag, reported on every log line and in the release manifest.
# CLOUDSFORGE_TAG=dev

# --- inbound events ------------------------------------------------------------------------------
#
# The HMAC key POST /v1/events verifies a delivery signature against. Policy still SIGNS nothing —
# contracts-events registers no `policy.*` topic, so it publishes nothing — but it now CONSUMES
# `identity.user.deleted`, and a consumer has to verify the MAC the producer's relay put on the
# body. The same estate-wide value every other service holds.
#
# UNSET IS A SUPPORTED STATE AND IS NOT "ACCEPT ANYTHING": the route answers 503 while it is unset,
# so the producer's relay retries and the erasure is queued and visible rather than lost. The
# service still boots, because policy's compose block has never carried the outbox secrets and
# making this required would turn a privacy fix into a service that will not start.
#
# SET IT. Until it is set, no user deletion reaches this service. It was measured absent on the
# running estate — the only service of 26 that reads an outbox secret and had never been given one
# (micro-org #196).
#
# The value is the estate's shared key, and it is GENERATED, never typed:
#
#   openssl rand -base64 48
#
# What is present is checked for SHAPE rather than length: base64 or hex only (a typed value has a
# hyphen or an underscore and is refused however long it is), at least 32 DECODED BYTES, and a
# measured entropy floor that rejects 64 zeros. There is no NODE_ENV exemption and no escape hatch
# — the placeholder that sat in a public compose file was 40 characters and passed every service
# in the estate (micro-org #142). Absent is still a supported state; absent-but-rubbish is not.
# OUTBOX_SIGNING_SECRET=CHANGE_ME_run_openssl_rand_base64_48
#
# Optional. The secrets to ACCEPT, comma-separated, newest first; defaults to OUTBOX_SIGNING_SECRET.
# It exists so the estate's shared key can be rotated one service at a time. EVERY ENTRY CLEARS THE
# SAME BAR: in an overlap window the outgoing key is the one an attacker already holds if it
# leaked, and "just for the drain" is how a placeholder survives the rotation meant to remove it.
# OUTBOX_ACCEPT_SECRETS=CHANGE_ME_run_openssl_rand_base64_48,CHANGE_ME_the_outgoing_one

# --- not read by this service ------------------------------------------------------------------
#
# OTEL_EXPORTER_OTLP_ENDPOINT and the rest of OTEL_* are read by the OpenTelemetry SDK loaded
# ahead of the process, not by src/env.ts. They belong in the deploy, not here.
#
# POLICY_TEST_DATABASE_URL is read only by the test suite, and only when its name contains
# "test" — the database-backed tests truncate.
